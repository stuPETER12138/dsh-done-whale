{
  "name": "dsh-done-whale",
  "version": "0.3.0",
  "description": "DeepSeek Harness 标签页鲸鱼状态灯：完成变绿，待处理变琥珀，支持自定义颜色。",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-isolation=none",
    "check": "npm run build && npm test"
  },
  "engines": { "node": ">=22" },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.2" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.5-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.5-rc.1"
  },
  "devDependencies": { "esbuild": "^0.25.12", "react": "^18.3.1", "react-test-renderer": "^18.3.1" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": { "type": "git", "url": "git+https://github.com/stuPETER12138/dsh-done-whale.git" },
  "homepage": "https://github.com/stuPETER12138/dsh-done-whale#readme",
  "bugs": { "url": "https://github.com/stuPETER12138/dsh-done-whale/issues" },
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "favicon", "whale"],
  "license": "MIT"
}
